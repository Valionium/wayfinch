{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cp-trip.v1.schema.json",
  "title": "The attributes of the GPX extension <cp:trip> (namespace urn:x-wayfinch:trip:1), as an object of strings (Contract 2). Readers ignore attributes they do not know",
  "type": "object",
  "required": [
    "v",
    "nights",
    "route"
  ],
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": "1"
    },
    "nights": {
      "type": "string",
      "pattern": "^([0-9]|[12][0-9]|30)$"
    },
    "nightsFrom": {
      "const": "suggested"
    },
    "departureDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "month": {
      "type": "string",
      "pattern": "^([1-9]|1[0-2])$"
    },
    "sleep": {
      "enum": [
        "camp",
        "mixed",
        "indoor"
      ]
    },
    "pace": {
      "enum": [
        "steady",
        "sporting",
        "hard"
      ]
    },
    "flatKph": {
      "type": "string",
      "pattern": "^\\d+(\\.\\d+)?$"
    },
    "startName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "endName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "route": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
